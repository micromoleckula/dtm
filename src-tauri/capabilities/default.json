{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability set for the retro garage drift game.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:app:allow-exit",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-exists",
    "fs:allow-mkdir"
  ]
}
